<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing worth backing up: the only stored data is the printer's LAN address and a toggle. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
